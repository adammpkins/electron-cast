{
  "name": "electron-cast",
  "version": "0.0.0",
  "description": "Chromecast for Electron: the chrome.cast sender API for web pages, backed by device discovery and the Cast v2 protocol in the main process.",
  "keywords": [
    "electron",
    "chromecast",
    "cast",
    "google-cast",
    "chrome.cast",
    "castv2"
  ],
  "license": "MIT",
  "author": "Adam Perkins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adammpkins/electron-cast.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "oxlint src test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3"
  }
}
