{
  "name": "electron-cast",
  "version": "0.5.0-next.1",
  "description": "The Cast support Electron never shipped: pages cast to Chromecasts and Google Cast devices as they do in Chrome, with Google's SDK unchanged. No dependencies.",
  "keywords": [
    "electron",
    "chromecast",
    "cast",
    "google-cast",
    "chrome.cast",
    "castv2",
    "presentation-api",
    "mirroring",
    "screen-mirroring",
    "dial"
  ],
  "license": "MIT",
  "homepage": "https://adammpkins.github.io/electron-cast/",
  "author": "Adam Perkins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adammpkins/electron-cast.git"
  },
  "bugs": {
    "url": "https://github.com/adammpkins/electron-cast/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./main": {
      "import": {
        "types": "./dist/electron/main.d.ts",
        "default": "./dist/electron/main.js"
      },
      "require": {
        "types": "./dist/cjs/electron/main.d.ts",
        "default": "./dist/cjs/electron/main.js"
      }
    },
    "./preload": {
      "import": {
        "types": "./dist/electron/preload.d.ts",
        "default": "./dist/electron/preload.js"
      },
      "require": {
        "types": "./dist/cjs/electron/preload.d.ts",
        "default": "./dist/cjs/electron/preload.js"
      }
    },
    "./polyfill": {
      "import": {
        "types": "./dist/polyfill/install.d.ts",
        "default": "./dist/polyfill/install.js"
      },
      "require": {
        "types": "./dist/cjs/polyfill/install.d.ts",
        "default": "./dist/cjs/polyfill/install.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "electron-cast": "dist/cli.js"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs && node scripts/stamp-build-time.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-force-exit --test-timeout=20000 \"test/**/*.test.ts\"",
    "lint": "oxlint src test",
    "canary": "node tools/sdk-canary.mjs",
    "docs:check": "node tools/docs-check.mjs",
    "docs:check:chromium": "node tools/docs-check-chromium.mjs",
    "trace:capture": "node tools/capture-trace.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run docs:check",
    "prepack": "npm run build",
    "smoke": "npm run build && node smoke/run.mjs",
    "live:iframe": "node examples/live-iframe/run.mjs",
    "probe:discovery": "node tools/probe-discovery.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "electron": ">=35"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  }
}
