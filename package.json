{
  "name": "electron-cast",
  "version": "0.1.0",
  "description": "Chromecast for Electron: the chrome.cast sender API for web pages, backed by device discovery and the Cast v2 protocol in the main process.",
  "keywords": [
    "electron",
    "chromecast",
    "cast",
    "google-cast",
    "chrome.cast",
    "castv2"
  ],
  "license": "MIT",
  "author": "Adam Perkins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adammpkins/electron-cast.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/electron/main.d.ts",
      "default": "./dist/electron/main.js"
    },
    "./preload": {
      "types": "./dist/electron/preload.d.ts",
      "default": "./dist/electron/preload.js"
    },
    "./polyfill": {
      "types": "./dist/polyfill/install.d.ts",
      "default": "./dist/polyfill/install.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-force-exit --test-timeout=20000 \"test/**/*.test.ts\"",
    "lint": "oxlint src test",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3"
  }
}
